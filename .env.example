# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Required for OpenRouter chat API integration (GPT, Llama, Qwen, etc.)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# NVIDIA_API_KEY: Required for NVIDIA NIM API calls directly (e.g., Llama Guard, Qwen3 Coder)
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration (Supports standard Vercel + Supabase integrations)
# Formats recognized automatically by client & server:
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Standard Vercel Supabase integration variables also supported:
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Firebase Client Configuration (Optional, required for real Google Workspace authentication)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGE_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# MCP Platform Integrations (OAuth Client IDs - Next.js & Vite Compatible)
NEXT_PUBLIC_SUPABASE_CLIENT_ID="YOUR_SUPABASE_CLIENT_ID"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
NEXT_PUBLIC_GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
NEXT_PUBLIC_VERCEL_CLIENT_ID="YOUR_VERCEL_CLIENT_ID"
NEXT_PUBLIC_NETLIFY_CLIENT_ID="YOUR_NETLIFY_CLIENT_ID"
NEXT_PUBLIC_FIGMA_CLIENT_ID="YOUR_FIGMA_CLIENT_ID"
NEXT_PUBLIC_AIRTABLE_CLIENT_ID="YOUR_AIRTABLE_CLIENT_ID"
NEXT_PUBLIC_CANVA_CLIENT_ID="YOUR_CANVA_CLIENT_ID"

VITE_SUPABASE_CLIENT_ID="YOUR_SUPABASE_CLIENT_ID"
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
VITE_GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
VITE_VERCEL_CLIENT_ID="YOUR_VERCEL_CLIENT_ID"
VITE_NETLIFY_CLIENT_ID="YOUR_NETLIFY_CLIENT_ID"
VITE_FIGMA_CLIENT_ID="YOUR_FIGMA_CLIENT_ID"
VITE_AIRTABLE_CLIENT_ID="YOUR_AIRTABLE_CLIENT_ID"
VITE_CANVA_CLIENT_ID="YOUR_CANVA_CLIENT_ID"

